NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 로컬 개발 로그인 화면에서만 기존 이메일 계정을 자동 입력한다.
# NEXT_PUBLIC_PREFILL_LOGIN_EMAIL=
# NEXT_PUBLIC_PREFILL_LOGIN_PASSWORD=
# NEXT_PUBLIC 값은 브라우저 번들에 포함될 수 있으므로 배포 환경에는 등록하지 않는다.

# 기존 원장 계정의 카카오 연결 기간에만 두 값을 함께 1로 설정한다.
# NEXT_PUBLIC_LEGACY_OWNER_LINK_ENABLED=1
# LEGACY_OWNER_LINK_ENABLED=1

# 카카오 REST API 키와 Client Secret은 Supabase 콘솔에만 입력한다.
# NEXT_PUBLIC_E2E_DEMO, service-role key, SUPABASE_ACCESS_TOKEN은 앱 실행 환경변수가 아니다.
KASI_HOLIDAY_API_KEY=
